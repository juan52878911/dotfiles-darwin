#  ~/.zshrc  — gestionado por home-manager desde ~/dotfiles/home/zshrc
#  Orden importante: instant prompt arriba del todo, syntax-highlighting al final.

# ─── Powerlevel10k instant prompt (lo más arriba posible) ─────────────────────
if [[ -r "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh" ]]; then
  source "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh"
fi

BREW_PREFIX="/opt/homebrew"
NIX_SW="/run/current-system/sw"
# Carga el primero que exista: los plugins vienen de Nix (nix-darwin), con
# Homebrew o el clon antiguo como respaldo.
_zsh_cargar() { local f; for f in "$@"; do [[ -r "$f" ]] && { source "$f"; return 0; }; done; return 1; }
# Sin duplicados en PATH: cada shell anidado (tmux, Claude, popups) ya no lo
# alarga. Mantiene la primera aparición, así que el orden de prioridad se conserva.
typeset -U path PATH

# ─── PATH ─────────────────────────────────────────────────────────────────────
# nix-darwin (darwin-rebuild y systemPackages). Al final: Homebrew sigue mandando.
export PATH="$PATH:/run/current-system/sw/bin"
export PATH="$HOME/.local/bin:$PATH"
export PATH="$HOME/go/bin:$PATH"
export PATH="$HOME/.opencode/bin:$PATH"
export BUN_INSTALL="$HOME/.bun"
export PATH="$BUN_INSTALL/bin:$PATH"
export PATH="$HOME/.cargo/bin:$PATH"
[[ -d "$BREW_PREFIX/opt/llvm@21/bin" ]] && export PATH="$BREW_PREFIX/opt/llvm@21/bin:$PATH"

# ─── Node / nvm (carga diferida) ──────────────────────────────────────────────
# Cargar nvm.sh al arrancar costaba ~200 ms (70% del inicio, medido con zprof).
export NVM_DIR="$HOME/.nvm"
if [[ -r "$NVM_DIR/alias/default" ]]; then
  _nvm_def="$(<"$NVM_DIR/alias/default")"
  for _nvm_dir in "$NVM_DIR/versions/node/v${_nvm_def#v}"*(N/); do
    export PATH="${_nvm_dir}/bin:$PATH"; break
  done
  unset _nvm_def _nvm_dir
fi
nvm() {
  unset -f nvm
  [[ -s "$BREW_PREFIX/opt/nvm/nvm.sh" ]] && source "$BREW_PREFIX/opt/nvm/nvm.sh"
  nvm "$@"
}

# ─── Pyenv (carga diferida) ───────────────────────────────────────────────────
# `pyenv init` costaba ~140 ms en cada shell. Los shims ya resuelven la versión
# de cada carpeta (.python-version); el init completo solo hace falta para
# subcomandos como `pyenv shell` o activar virtualenvs, y se carga al usarlos.
export PYENV_ROOT="$HOME/.pyenv"
export PATH="$PYENV_ROOT/shims:$PYENV_ROOT/bin:$PATH"
pyenv() {
  unset -f pyenv
  eval "$(command pyenv init -)"
  command pyenv commands 2>/dev/null | grep -qx virtualenv-init && eval "$(command pyenv virtualenv-init -)"
  pyenv "$@"
}

# ─── Historial ────────────────────────────────────────────────────────────────
HISTFILE="$HOME/.zsh_history"
HISTSIZE=50000
SAVEHIST=50000
setopt EXTENDED_HISTORY INC_APPEND_HISTORY SHARE_HISTORY
setopt HIST_IGNORE_DUPS HIST_IGNORE_ALL_DUPS HIST_IGNORE_SPACE
setopt HIST_REDUCE_BLANKS HIST_VERIFY

setopt AUTO_CD AUTO_PUSHD PUSHD_IGNORE_DUPS INTERACTIVE_COMMENTS NO_BEEP

# ─── Autocompletado ───────────────────────────────────────────────────────────
autoload -Uz compinit
_zcompdump="${XDG_CACHE_HOME:-$HOME/.cache}/zcompdump"
if [[ -n "$_zcompdump"(#qN.mh+24) ]]; then compinit -d "$_zcompdump"; else compinit -C -d "$_zcompdump"; fi
unset _zcompdump

zmodload zsh/complist
zstyle ':completion:*' menu select
zstyle ':completion:*' matcher-list 'm:{a-zA-Z}={A-Za-z}' 'r:|=*'
zstyle ':completion:*' list-colors "${(s.:.)LS_COLORS}"
zstyle ':completion:*' group-name ''
zstyle ':completion:*:descriptions' format $'\e[38;5;110m %d\e[0m'
zstyle ':completion:*' use-cache on
zstyle ':completion:*' cache-path "${XDG_CACHE_HOME:-$HOME/.cache}/zcompcache"

if command -v carapace >/dev/null 2>&1; then
  export CARAPACE_BRIDGES='zsh,fish,bash'
  source <(carapace _carapace zsh)
fi

# ─── Sugerencias en gris ──────────────────────────────────────────────────────
if _zsh_cargar "$NIX_SW/share/zsh-autosuggestions/zsh-autosuggestions.zsh" \
               "$BREW_PREFIX/share/zsh-autosuggestions/zsh-autosuggestions.zsh"; then
  ZSH_AUTOSUGGEST_HIGHLIGHT_STYLE='fg=#6c7086'
  ZSH_AUTOSUGGEST_STRATEGY=(history completion)
fi

# ─── fzf ──────────────────────────────────────────────────────────────────────
if command -v fzf >/dev/null 2>&1; then
  source <(fzf --zsh)
  export FZF_DEFAULT_COMMAND="fd --hidden --strip-cwd-prefix --exclude .git"
  export FZF_CTRL_T_COMMAND="$FZF_DEFAULT_COMMAND"
  export FZF_ALT_C_COMMAND="fd --type=d --hidden --strip-cwd-prefix --exclude .git"
  export FZF_DEFAULT_OPTS=" \
    --height 45% --layout=reverse --border=rounded --info=inline \
    --color=bg+:#313244,bg:#1e1e2e,spinner:#f5e0dc,hl:#f38ba8 \
    --color=fg:#cdd6f4,header:#f38ba8,info:#cba6f7,pointer:#f5e0dc \
    --color=marker:#b4befe,fg+:#cdd6f4,prompt:#cba6f7,hl+:#f38ba8 \
    --color=border:#585b70 --prompt='  ' --pointer='▶' --marker='✓'"
  export FZF_CTRL_T_OPTS="--preview 'bat --style=numbers --color=always --line-range=:200 {}'"
  export FZF_ALT_C_OPTS="--preview 'eza --tree --level=2 --color=always {}'"
fi

# ─── zoxide y atuin ───────────────────────────────────────────────────────────
command -v zoxide >/dev/null 2>&1 && eval "$(zoxide init zsh)"
# atuin después de fzf para que gane Ctrl+R; ↑ sigue siendo el historial normal
command -v atuin >/dev/null 2>&1 && eval "$(atuin init zsh --disable-up-arrow)"

# ─── direnv: entornos por proyecto ────────────────────────────────────────────
# Con un .envrc que diga `use flake`, al entrar en la carpeta se cargan las
# versiones que declare su flake.nix, y al salir se descargan. Es lo que sustituye
# a nvm/pyenv/sdkman POR PROYECTO, sin tocar las versiones globales.
if command -v direnv >/dev/null 2>&1; then
  emulate zsh -c "$(direnv hook zsh)"
fi

# ─── Atajos ───────────────────────────────────────────────────────────────────
bindkey -e
bindkey '^[[A' history-search-backward
bindkey '^[[B' history-search-forward
bindkey '^[[1;5C' forward-word
bindkey '^[[1;5D' backward-word
bindkey '^H' backward-kill-word
bindkey '^[[3~' delete-char
bindkey '^U' backward-kill-line
bindkey -M menuselect 'h' vi-backward-char
bindkey -M menuselect 'j' vi-down-line-or-history
bindkey -M menuselect 'k' vi-up-line-or-history
bindkey -M menuselect 'l' vi-forward-char

_fzf_edit() { local f; f=$(fzf --preview 'bat --color=always {}') && [[ -n "$f" ]] && nvim "$f"; }
zle -N _fzf_edit
bindkey '^F' _fzf_edit

# ─── Aliases ──────────────────────────────────────────────────────────────────
alias ll="ls -l"
alias la="ls -a"
if command -v eza >/dev/null 2>&1; then
  alias l="eza --icons --group-directories-first"
  alias lt="eza --tree --level=2 --icons --group-directories-first"
  alias lla="eza -la --icons --group-directories-first --git"
fi
command -v bat >/dev/null 2>&1 && alias cat="bat --paging=never" && alias catp="command cat"
alias reload="exec zsh"
alias zshrc="nvim ~/dotfiles/home/zshrc"
alias tmuxrc="nvim ~/dotfiles/config/tmux/tmux.conf"
alias vimrc="nvim ~/dotfiles/config/nvim/init.lua"
alias dots="cd ~/dotfiles"
# Arrancar un entorno reproducible en la carpeta actual.
# Va por script porque dentro de un repo git hace falta `git add -N flake.nix`
# o Nix no lo ve y direnv no carga nada.
alias nx-node='~/dotfiles/home/nx-init.sh node'
alias nx-py='~/dotfiles/home/nx-init.sh python'
alias nx-rust='~/dotfiles/home/nx-init.sh rust'
alias nx-java='~/dotfiles/home/nx-init.sh java'
alias nx-go='~/dotfiles/home/nx-init.sh go'
alias gs="git status -sb"
alias gd="git diff"
alias gl="git log --oneline --graph --decorate -20"
alias ports="lsof -nP -iTCP -sTCP:LISTEN"

# ─── Claude Code ──────────────────────────────────────────────────────────────
# >>> claude-auto-retry >>>
# Envoltorio de claude-auto-retry (reintenta tras límites de uso). El claude que
# lanza es el del PATH, es decir, el shim de ws: cuenta y MCPs por organización.
unalias claude 2>/dev/null || true
claude() {
  local -a _car; _car=("$NVM_DIR"/versions/node/*/lib/node_modules/claude-auto-retry/src/launcher.js(N))
  local launcher="${_car[-1]}"
  local -a args; args=("$@")
  if [[ "$CLAUDE_AUTO_RETRY_ACTIVE" == "1" || -z "$launcher" ]]; then
    command claude "${args[@]}"; return $?
  fi
  export CLAUDE_AUTO_RETRY_ACTIVE=1
  local _car_exit
  setopt localoptions localtraps
  trap 'unset CLAUDE_AUTO_RETRY_ACTIVE' INT TERM
  node "$launcher" "${args[@]}"
  _car_exit=$?
  unset CLAUDE_AUTO_RETRY_ACTIVE
  return $_car_exit
}
# <<< claude-auto-retry <<<

# ─── Prompt ───────────────────────────────────────────────────────────────────
_zsh_cargar "$NIX_SW/share/zsh-powerlevel10k/powerlevel10k.zsh-theme" \
            ~/powerlevel10k/powerlevel10k.zsh-theme \
            "$BREW_PREFIX/share/powerlevel10k/powerlevel10k.zsh-theme"
[[ ! -f ~/.p10k.zsh ]] || source ~/.p10k.zsh
[[ ! -f ~/.p10k.catppuccin.zsh ]] || source ~/.p10k.catppuccin.zsh

# ─── SDKMAN (carga diferida) ──────────────────────────────────────────────────
# Su init costaba ~40 ms y además apuntaba JAVA_HOME a candidates/java/current
# (Java 8). Ahora: los `current` de cada herramienta al PATH (lo mismo que hacía
# el init) y el comando `sdk` se carga al usarlo.
export SDKMAN_DIR="$HOME/.sdkman"
for _sdk_bin in "$SDKMAN_DIR"/candidates/*/current/bin(N/); do
  export PATH="$PATH:$_sdk_bin"
done
unset _sdk_bin
sdk() {
  unset -f sdk
  [[ -s "$SDKMAN_DIR/bin/sdkman-init.sh" ]] && source "$SDKMAN_DIR/bin/sdkman-init.sh"
  sdk "$@"
}

# Java 21 por defecto (jdtls lo necesita); delante de los `current` de SDKMAN.
export JAVA_HOME="$SDKMAN_DIR/candidates/java/21.0.2-graalce"
export PATH="$JAVA_HOME/bin:$PATH"

[[ -s "$HOME/.bun/_bun" ]] && source "$HOME/.bun/_bun"

# ─── Resaltado de sintaxis (SIEMPRE lo último) ────────────────────────────────
if _zsh_cargar "$NIX_SW/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh" \
               "$BREW_PREFIX/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh"; then
  typeset -gA ZSH_HIGHLIGHT_STYLES
  ZSH_HIGHLIGHT_STYLES[command]='fg=#a6e3a1'
  ZSH_HIGHLIGHT_STYLES[builtin]='fg=#a6e3a1'
  ZSH_HIGHLIGHT_STYLES[function]='fg=#a6e3a1'
  ZSH_HIGHLIGHT_STYLES[alias]='fg=#94e2d5'
  ZSH_HIGHLIGHT_STYLES[unknown-token]='fg=#f38ba8'
  ZSH_HIGHLIGHT_STYLES[path]='fg=#89b4fa,underline'
  ZSH_HIGHLIGHT_STYLES[single-quoted-argument]='fg=#f9e2af'
  ZSH_HIGHLIGHT_STYLES[double-quoted-argument]='fg=#f9e2af'
  ZSH_HIGHLIGHT_STYLES[comment]='fg=#6c7086'
fi
# ─── VibeVoice (en el disco externo) ──────────────────────────────────────────
_vibevoice() {
  local vv=/Volumes/ExternAscci/Github/VibeVoiceNix
  local wt="$vv/.claude/worktrees/vibevoice-simple-install-16fa50/scripts"
  [[ -d "$wt" ]] || wt="$vv/scripts"
  if [[ ! -x "$vv/pkgs/vibevoice/.venv/bin/python" ]]; then
    print -u2 "VibeVoice: el disco ExternAscci no está montado (o falta su .venv)"; return 1
  fi
  "$vv/pkgs/vibevoice/.venv/bin/python" "$wt/$1" "${@:2}"
}
decir()  { _vibevoice decir.py "$@"; }
clonar() { _vibevoice clonar_voz.py "$@"; }

# KLING_TOKEN (gateway de kindling) ya no se exporta aquí: lo inyecta ws
# ([env] de private/ws/ws.toml) solo al lanzar claude/opencode, también fuera
# de las organizaciones. Así no queda en el entorno de todos los procesos.

# LM Studio CLI
[[ -d "$HOME/.lmstudio/bin" ]] && export PATH="$PATH:$HOME/.lmstudio/bin"

# kling
[[ -f "$HOME/.config/kling/completion.zsh" ]] && . "$HOME/.config/kling/completion.zsh"

# ─── ws: organizaciones y espacios de trabajo ────────────────────────────────
# Shims de claude, opencode y gh: usan la cuenta y los MCPs de la organización
# de la carpeta (o de la sesión de tmux). Fuera de una organización hacen exec
# directo del binario de siempre. Va al final para quedar primero en el PATH.
export PATH="$HOME/.local/share/ws/shims:$PATH"
# Al entrar en un repo de una org conocida (github_orgs en ws.toml), se registra
# solo como proyecto suyo: etiqueta de Finder, credenciales y marca de tmux.
autoload -Uz add-zsh-hook
_ws_descubrir() { [[ -e .git ]] && (ws descubrir "$PWD" >/dev/null 2>&1 &) }
add-zsh-hook chpwd _ws_descubrir
