# === Claude Code: sesion fijada para el proyecto bun ===
# Sesion "bun-lockfile-schema" (docs + tipos de bun.lock, PR oven-sh/bun#34204).
# En esta ruta exacta, `claude` sin argumentos reanuda esta sesion con su nombre.
# Para iniciar una sesion NUEVA aqui: usa `command claude`.
export CLAUDE_BUN_DIR="/Volumes/ExternAscci/Github/bun"
export CLAUDE_BUN_SESSION="e1ab2f77-e6da-4e5d-bc8a-2b78cdf4dbe1"
claude() {
  local sess="$HOME/.claude/projects/-Volumes-ExternAscci-Github-bun/${CLAUDE_BUN_SESSION}.jsonl"
  if [[ $# -eq 0 && "$PWD" == "$CLAUDE_BUN_DIR" && -f "$sess" ]]; then
    command claude --resume "$CLAUDE_BUN_SESSION" --name "bun-lockfile-schema"
  else
    command claude "$@"
  fi
}
# Reanudar la sesion "bun-lockfile-schema" desde cualquier ruta:
alias claude-bun='command claude --resume "$CLAUDE_BUN_SESSION" --name "bun-lockfile-schema"'


